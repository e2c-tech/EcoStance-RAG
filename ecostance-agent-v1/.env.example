# Database Configuration
DATABASE_URL=sqlite:///./tenant_system.db
DISTANCE_METRIC=Cosine
EMBEDDING_SERVER_PORT=9003
# For PostgreSQL: postgresql://user:password@localhost/dbname

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Google Gemini API
GOOGLE_API_KEY=your_google_api_key_here

# JWT Configuration
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:9002,http://localhost:5173

# OCR Configuration
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_MIN_CONFIDENCE=0.3
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe  # Windows only, if not in PATH

# Feature Flags
ENABLE_PUBLIC_CHAT=true
ENABLE_PUBLIC_AGENT=true
ENABLE_LLM_TRACKING=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Cleanup Service
CLEANUP_INTERVAL_HOURS=24
CLEANUP_RETENTION_DAYS=30

# STT (Speech-to-Text) Configuration
STT_PROVIDER=whisper_tiny  # Options: whisper_tiny, whisper_base, whisper_large, assemblyai, azure, google
WHISPER_MODEL=tiny  # For Whisper: tiny, base, small, medium, large

# AssemblyAI Configuration (if using assemblyai provider)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Azure Speech Configuration (if using azure provider)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Google Speech Configuration (if using google provider)
GOOGLE_CREDENTIALS_PATH=path/to/google-credentials.json

# LangSmith Configuration (for tracing and monitoring)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=ecostance-agent-v1
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# LangSmith Advanced Configuration (optional)
LANGSMITH_TRACING_LEVEL=standard  # Options: disabled, basic, standard, detailed, debug
LANGSMITH_EXCLUDE_PATHS=/health,/docs,/redoc,/openapi.json
LANGSMITH_INCLUDE_REQUEST_BODY=false
LANGSMITH_INCLUDE_RESPONSE_BODY=false
LANGSMITH_MAX_BODY_SIZE=1000
LANGSMITH_SAMPLING_RATE=1.0

# E-Commerce Agent Configuration
ECOMMERCE_API_URL=http://your-ecommerce-backend/api
