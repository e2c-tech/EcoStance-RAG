# Qdrant Vector Database
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_URL=your-qdrant-url

# Google Gemini API
GOOGLE_API_KEY=your-google-api-key

# Tenant System Database
DATABASE_URL=postgresql://user:password@host:port/database

# Encryption Key for Database Credentials (if not using Vault)
ENCRYPTION_KEY=generate-with-python-cryptography-fernet

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# HashiCorp Vault Configuration (Optional - for secure secrets management)
# Set VAULT_ENABLED=true to use Vault instead of ENCRYPTION_KEY
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=root
