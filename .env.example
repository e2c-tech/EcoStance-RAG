# ==========================================
# Centralized Environment Configuration Template
# ==========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials!

# ------------------------------------------
# Main Backend (ecostance-agent-v1) - Port 9000
# ------------------------------------------

# Database Configuration (PostgreSQL - Cloud Hosted)
# Using cloud-hosted database (Aiven/Supabase/etc.)
# DATABASE_URL=postgresql://username:password@cloud-host:port/database_name?sslmode=require

# Qdrant Vector DB
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# LLM Providers
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Encryption Key for Database Credentials
ENCRYPTION_KEY=generate_secure_32_byte_base64_key

# JWT Configuration
JWT_SECRET_KEY=generate_secure_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Agent Configuration
QUICKSHIP_DB_PATH=QuickShip.db
LLM_PROVIDER=groq
AGENT_MODEL=llama-3.1-8b-instant
AGENT_TEMPERATURE=0.3
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_VECTOR_SIZE=1024
DISTANCE_METRIC=Cosine
EMBEDDING_SERVER_PORT=9003

# OCR Configuration
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_MIN_CONFIDENCE=0.3

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000
CACHE_INVALIDATE_ON_KB_UPDATE=true

# Database Connection Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# STT Configuration
STT_PROVIDER=whisper_tiny
WHISPER_MODEL=tiny

# LangSmith Configuration (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=your_project_name
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Multilingual Support
MULTILINGUAL_ENABLED=true
EMBEDDING_MODEL_TYPE=bge-m3

# Google OAuth (Gmail Integration for Ecostance Agent)
ECOSTANCE_GOOGLE_CLIENT_ID=your_ecostance_google_client_id.apps.googleusercontent.com
ECOSTANCE_GOOGLE_CLIENT_SECRET=your_ecostance_google_client_secret
ECOSTANCE_GOOGLE_REDIRECT_URI=http://localhost:5173/ecostance-ui/gmail/callback

# ------------------------------------------
# CORS Configuration
# ------------------------------------------
ALLOWED_ORIGINS=http://localhost:9002,http://localhost:5173

# ------------------------------------------
# Feature Flags
# ------------------------------------------
ENABLE_PUBLIC_CHAT=true
ENABLE_PUBLIC_AGENT=true

# ------------------------------------------
# Frontend Configurations
# ------------------------------------------

# API Base URLs
# For Docker: use service names
# For local dev: use localhost
VITE_API_BASE_URL=http://localhost:9000/api/v1

# Environment
VITE_ENVIRONMENT=development
VITE_BYPASS_AUTH=false


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
FRONTEND_URL=http://localhost:5173/ecostance-ui   # Or your actual frontend URL